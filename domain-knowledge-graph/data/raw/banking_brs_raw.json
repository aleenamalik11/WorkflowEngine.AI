  "rules": [
    {
      "id": "BR-001",
      "name": "User must exist before banking operations",
      "statement": "Every user must exist before performing banking operations."
    },
    {
      "id": "BR-002",
      "name": "Only active accounts may transfer funds",
      "statement": "Only active accounts may participate in fund transfers."
    },
    {
      "id": "BR-003",
      "name": "Transfer amount must be positive",
      "statement": "Transfer amount must be greater than zero."
    },
    {
      "id": "BR-004",
      "name": "Transfer cannot exceed available balance",
      "statement": "Transfer amount must not exceed available balance."
    },
    {
      "id": "BR-005",
      "name": "Source and destination accounts must differ",
      "statement": "Source and destination accounts must be different."
    },
    {
      "id": "BR-006",
      "name": "Successful transfer generates transactions",
      "statement": "Every successful transfer generates financial transactions."
    },
    {
      "id": "BR-007",
      "name": "Balances remain synchronized",
      "statement": "Account balances must remain synchronized after transfer completion."
    },
    {
      "id": "BR-008",
      "name": "Transfer produces audit trail",
      "statement": "Every transfer shall produce an audit trail."
    },
    {
      "id": "BR-009",
      "name": "Failed transfer does not modify balances",
      "statement": "Failed transfers shall not modify balances."
    },
    {
      "id": "BR-010",
      "name": "Transaction history is immutable",
      "statement": "Transaction history shall remain immutable."
    }
  ],
